---
// Vibe CMS · /admin (P6 sign-in, P7 editor). Runs on demand (never prerendered). Signed out → sign-in form; temporary
// password → choose your own; signed in → the editor (src/admin, started by the script below) with the editable part
// of cms.config and who is signed in. Nothing site-specific is written here, everything comes from config.
// Every form posts (method="post"): if the script has not run, a password never lands in the URL.
import { env } from "cloudflare:workers";
import config from "virtual:vibe-cms/config";
import content from "virtual:vibe-cms/content";
import { adminBoot, bootJson, createSiteRuntime, type SiteEnv } from "@sonle282/vibe-cms/api";
import "./admin.css";

export const prerender = false;
const { auth } = createSiteRuntime({ config, content, env: env as SiteEnv, dev: import.meta.env.DEV });
const identity = await auth.identify(Astro.request);
const current = identity ? await auth.session(Astro.request) : null;
const state = identity === undefined ? "not-configured" : identity === null ? "signed-out" : identity.mustChangePassword ? "change-password" : "signed-in";
const boot = identity && state === "signed-in"
  ? adminBoot(config, current
    ? { id: current.user.id, username: current.user.username, displayName: current.user.display_name, role: current.user.role }
    : { id: identity.userId, username: identity.userId, displayName: "Local developer", role: identity.role })
  : null;
for (const [name, value] of Object.entries({
  "cache-control": "no-store",
  "x-frame-options": "DENY",
  "content-security-policy": "frame-ancestors 'none'",
  "referrer-policy": "same-origin",
  "x-content-type-options": "nosniff",
})) Astro.response.headers.set(name, value);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Vibe CMS · {config.site.name}</title>
  </head>
  <body class="vc-page" data-state={state}>
    {state !== "signed-in" && (
      <main class="vc-sign">
        <p class="vc-sign-brand">{config.site.name} <span>· Vibe CMS</span></p>

        {state === "not-configured" && <p id="state" data-state={state}>Sign-in is not set up on this site yet (CMS_DB and SESSION bindings).</p>}

        {state === "signed-out" && (
          <form id="login" method="post" data-state={state} class="vc-sign-card">
            <h1>Sign in</h1>
            <label for="username">Username</label><input id="username" name="username" class="vc-input" autocomplete="username" autocapitalize="none" spellcheck="false" required />
            <label for="password">Password</label><input id="password" name="password" class="vc-input" type="password" autocomplete="current-password" required />
            <button type="submit" class="vc-button vc-primary">Sign in</button>
            <p class="vc-error" role="alert"></p>
          </form>
        )}

        {state === "change-password" && (
          <form id="change" method="post" data-state={state} class="vc-sign-card">
            <h1>Choose your own password</h1>
            <p class="vc-help">You signed in with a temporary password. Pick a new one (at least 12 characters) to continue.</p>
            <input type="text" name="username" autocomplete="username" value={current?.user.username ?? ""} hidden readonly />
            <label for="current">Temporary password</label><input id="current" name="currentPassword" class="vc-input" type="password" autocomplete="current-password" required />
            <label for="new">New password</label><input id="new" name="newPassword" class="vc-input" type="password" autocomplete="new-password" minlength="12" required />
            <button type="submit" class="vc-button vc-primary">Save password</button>
            <p class="vc-error" role="alert"></p>
          </form>
        )}
      </main>
    )}

    {state === "signed-in" && boot && (
      <div id="vibe-cms-admin" class="vc-root" data-state={state}>
        <p class="vc-loading">Loading the editor…</p>
        <noscript><p>The editor needs JavaScript. Turn it on and reload.</p></noscript>
      </div>
      <script type="application/json" id="vibe-cms-boot" set:html={bootJson(boot)} />
    )}

    <script>
      import { startAdmin, type AdminBoot } from "@sonle282/vibe-cms/admin";

      const send = async (method: string, path: string, body?: unknown) => {
        const response = await fetch(path, { method, headers: { "content-type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body), credentials: "same-origin" });
        const data = await response.json().catch(() => ({}));
        return { ok: response.ok, data };
      };
      const wire = (id: string, run: (form: HTMLFormElement) => Promise<{ ok: boolean; data: { message?: string } }>) => {
        const form = document.getElementById(id) as HTMLFormElement | null;
        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const button = form.querySelector("button");
          if (button) button.disabled = true;
          const result = await run(form);
          if (result.ok) location.reload();
          else { form.querySelector(".vc-error")!.textContent = result.data.message ?? "Something went wrong."; if (button) button.disabled = false; }
        });
      };
      const value = (form: HTMLFormElement, name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
      wire("login", (form) => send("POST", "/api/auth/login", { username: value(form, "username"), password: value(form, "password") }));
      wire("change", (form) => send("PUT", "/api/auth/password", { currentPassword: value(form, "currentPassword"), newPassword: value(form, "newPassword") }));

      const root = document.getElementById("vibe-cms-admin");
      const data = document.getElementById("vibe-cms-boot");
      if (root && data?.textContent) startAdmin({ root, boot: JSON.parse(data.textContent) as AdminBoot });
    </script>
  </body>
</html>
