// CI only: a site that is set up (the bindings `vibe-cms setup` writes); nothing here is deployed.
{
  "name": "existing-site",
  "compatibility_date": "2026-09-23",
  "d1_databases": [{ "binding": "CMS_DB", "database_name": "existing-site-cms", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "node_modules/@sonle282/vibe-cms/migrations" }],
  "kv_namespaces": [{ "binding": "SESSION", "id": "00000000000000000000000000000001" }],
  "r2_buckets": [{ "binding": "CMS_MEDIA", "bucket_name": "existing-site-media" }],
  "ratelimits": [
    { "name": "CMS_LOGIN_LIMITER", "namespace_id": "100001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CMS_PUBLISH_LIMITER", "namespace_id": "100002", "simple": { "limit": 20, "period": 60 } }
  ]
}
