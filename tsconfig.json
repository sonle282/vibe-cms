{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@sonle282/vibe-cms/api": [
        "./src/api/index.ts"
      ],
      "@sonle282/vibe-cms/store": [
        "./src/store/index.ts"
      ],
      "@sonle282/vibe-cms/admin": [
        "./src/admin/index.ts"
      ],
      "@sonle282/vibe-cms/media": [
        "./src/media/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "fixtures"
  ]
}
