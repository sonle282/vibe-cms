{
  "name": "@sonle282/vibe-cms",
  "version": "0.5.0",
  "description": "Vibe CMS — an Astro integration that adds a content editor (/admin) to a site, driven by one cms.config.ts.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonle282/vibe-cms.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./writer": {
      "types": "./dist/writer/index.d.ts",
      "default": "./dist/writer/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./locks": {
      "types": "./dist/locks/index.d.ts",
      "default": "./dist/locks/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./routes/*": "./src/routes/*",
    "./package.json": "./package.json",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist",
    "src/routes",
    "src/virtual.d.ts",
    "migrations",
    "docs/CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "fixtures/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "demo:build": "npm run build && npm run build -w fixtures/demo-site",
    "demo:smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run pack:check && npm run store:local && npm run api:local && npm run demo:build && npm run check -w fixtures/demo-site && npm run demo:smoke",
    "prepack": "npm run build",
    "pack:check": "node scripts/pack-check.mjs",
    "store:local": "node scripts/store-local.mjs",
    "api:local": "node scripts/api-local.mjs"
  },
  "peerDependencies": {
    "astro": "^7.2.1",
    "vite": ">=6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "astro": "^7.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
